<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.zodac</groupId>
        <artifactId>parent-pom</artifactId>
        <version>1.2.3</version>
    </parent>

    <artifactId>tracker-profiles</artifactId>
    <version>12.0.3-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>[${project.artifactId}] project</name>

    <modules>
        <module>tracker-profiles-screenshots</module>
    </modules>

    <properties>
        <!-- Override parent-pom default: this project started in 2024 -->
        <initial-year>2024</initial-year>

        <!-- Inherited from parent-pom, but defined here for version update testing
             (.github/scripts/update_dependency_versions.sh rewrites both) -->
        <java-release>27</java-release>
        <maven-release>3.10.0</maven-release>

        <!-- Version overrides: tracker-profiles is ahead of parent-pom 1.2.3 -->
        <jspecify.version>1.0.1</jspecify.version>
        <mockito.version>5.24.0</mockito.version>

        <!-- tracker-profiles-specific versions not in parent-pom -->
        <log4j-transform-maven-shade-plugin-extensions.version>0.2.0</log4j-transform-maven-shade-plugin-extensions.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>

        <!-- Linter path overrides. parent-pom builds these from ${project.basedir}, which is correct for this root POM
             but resolves to the module's own directory when inherited - so tracker-profiles-screenshots/pom.xml
             redefines all four against ${project.parent.basedir}. Keep the two blocks in sync. -->
        <config-overrides-directory>${project.basedir}/code-quality-config-overrides</config-overrides-directory>
        <checkstyle-project-suppression-file>${config-overrides-directory}/checkstyle-suppression.xml</checkstyle-project-suppression-file>
        <ci-config-directory>${project.basedir}/code-quality-config/java</ci-config-directory>
        <license-file>${project.basedir}/code-quality-config/licenses/bsd0.txt</license-file>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- tracker-profiles-specific: not in parent-pom -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-transform-maven-shade-plugin-extensions</artifactId>
                <version>${log4j-transform-maven-shade-plugin-extensions.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>

                <!-- Override: add resolve-dependency-properties execution (provides
                     ${org.mockito:mockito-core:jar} for the surefire argLine below), and
                     add log4j-core to the ignored-unused list (runtime-only dependency). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>default</id>
                            <configuration>
                                <ignoredUnusedDeclaredDependencies combine.children="append">
                                    <!-- Included so the logging files are on the classpath at runtime - not directly used -->
                                    <ignoredUnusedDeclaredDependency>org.apache.logging.log4j:log4j-core::</ignoredUnusedDeclaredDependency>
                                </ignoredUnusedDeclaredDependencies>
                            </configuration>
                        </execution>
                        <execution>
                            <id>resolve-dependency-properties</id>
                            <goals>
                                <goal>properties</goal>
                            </goals>
                            <phase>initialize</phase>
                        </execution>
                    </executions>
                </plugin>
                <!-- Override: add skip so lints/tests don't install the artifact -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <configuration>
                        <skip>${skip-artifact-build}</skip>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                    <configuration>
                        <createDependencyReducedPom>false</createDependencyReducedPom>
                        <skip>${skip-artifact-build}</skip>
                    </configuration>
                </plugin>

                <!-- Override: load Mockito as a Java agent at JVM startup (avoids dynamic
                     self-attach warnings on JDK 21+); disable CDS so the javaagent's bootstrap
                     classpath append does not trigger a JVM warning.
                     @{argLine} is late-bound so JaCoCo's prepare-agent can prepend its path. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!--suppress UnresolvedMavenProperty, set by maven-dependency-plugin's 'properties'-->
                        <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Override activate_all: also skip artifact builds when running the full quality gate. -->
        <profile>
            <id>activate_all</id>
            <activation>
                <property>
                    <name>all</name>
                </property>
            </activation>
            <properties>
                <jar-phase>none</jar-phase>
                <skip-artifact-build>true</skip-artifact-build>
            </properties>
        </profile>

        <!-- Override activate_linters: also skip artifact builds (no JAR needed for lint-only runs). -->
        <profile>
            <id>activate_linters</id>
            <activation>
                <property>
                    <name>lint</name>
                </property>
            </activation>
            <properties>
                <jar-phase>none</jar-phase>
                <skip-artifact-build>true</skip-artifact-build>
            </properties>
        </profile>
    </profiles>
</project>
