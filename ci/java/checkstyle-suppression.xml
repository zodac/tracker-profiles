<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- ApplicationConfiguration is a large configuration record with many env-var-loading methods and a print() method;
         splitting it further would not improve clarity. -->
    <suppress checks="JavaNCSS" files="ApplicationConfiguration\.java"/>

    <!-- JavaWebDriverFactory.createDriver sets up many Chrome options and preferences sequentially; extracting sub-methods
         would obscure the flat configuration sequence without reducing real complexity. -->
    <suppress checks="ExecutableStatementCount" files="JavaWebDriverFactory\.java" lines="78"/>

    <!-- ProfileScreenshotExecutor.screenshotTracker has a broad catch chain covering every failure mode; compressing it
         would hide the per-exception handling that is intentionally explicit. -->
    <suppress checks="ExecutableStatementCount" files="ProfileScreenshotExecutor\.java" lines="141"/>

    <!-- ProfileScreenshotExecutor.screenshotProfile orchestrates the full per-tracker screenshot flow; it is the
         authoritative sequence of steps and splitting it would scatter state across helpers without reducing logic. -->
    <suppress checks="ExecutableStatementCount" files="ProfileScreenshotExecutor\.java" lines="247"/>
</suppressions>
